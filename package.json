{
  "name": "schduled",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "concurrently -n next,worker -c blue,yellow \"next dev --turbopack\" \"tsx --watch scripts/worker.ts\"",
    "dev:next": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "docs:sync": "node scripts/sync-readme.mjs",
    "docs:check": "node scripts/sync-readme.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --watch scripts/worker.ts",
    "worker:start": "tsx scripts/worker.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:docker": "tsx scripts/migrate.ts",
    "db:reset": "tsx db/reset.ts && pnpm db:migrate",
    "make:admin": "tsx scripts/make-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "0.27.20",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/render": "^2.1.1",
    "better-auth": "~1.6.33",
    "clsx": "^2.1.1",
    "countries-and-timezones": "^3.11.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "date-holidays": "^3.37.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "files-sdk": "^3.1.1",
    "geist": "^1.8.1",
    "googleapis": "^186.0.0",
    "ical-generator": "^11.1.2",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.3",
    "nprogress": "^0.2.0",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "react-hook-form": "^7.90.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.2",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "embedded-postgres": "18.4.0-beta.17",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.8.3",
    "vitest": "^4.1.10"
  }
}
