# ─────────────────────────────────────────────────────────────────────────────
# Schduled — Docker Compose environment
#
#   cp .env.docker.example .env
#   # edit APP_SECRET + APP_URL below, then:
#   docker compose up -d
#
# This is the DOCKER-specific quick-start template. For the full reference —
# every optional variable (SMTP, Google, Zoom, storage, branding) — see
# .env.example; anything not set here can be configured later from the app
# itself (the setup wizard, or Settings → Services).
# ─────────────────────────────────────────────────────────────────────────────

# These are the only required env vars to boot — see .env.example for
# everything optional.

# Pre-filled to match the bundled `postgres` service in docker-compose.yml
# and docker-compose.build.yml. Using docker-compose.external-db.yml
# instead? Replace this with your own connection string (Neon, Supabase,
# RDS, ...) and ignore POSTGRES_USER/PASSWORD/DB below.
DATABASE_URL=postgresql://schduled:change-me@postgres:5432/schduled

# Session/crypto secret — MUST be at least 32 random characters.
# Generate one: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters

# Public base URL of this instance (used in every email link and OAuth
# redirect_uri). No trailing slash. MUST be the URL your users actually
# reach — not localhost — in production. Read live at runtime, so the same
# image works for any domain.
APP_URL=http://localhost:3000

# Recommended for self-hosting from the first deploy — see
# docs/self-hosting/installation.md "First login" section.
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED=true
ALLOW_PUBLIC_SIGNUP=false
INITIAL_ADMIN_EMAIL=you@example.com

# ── docker-compose.yml / docker-compose.external-db.yml only ────────────────
# Which published image tag to pull. This repo has not cut its first tagged
# release yet (see CHANGELOG.md and .github/workflows/release.yml) — use
# "main" until it has; switch to a pinned version (e.g. "1.0.0") once one
# exists, and always pin a version in production.
IMAGE_TAG=main

# Host port to bind, if 3000 is already taken on this machine. Never set
# PORT here — the app reads that internally and env_file passes every var
# into the container, so PORT would also move the app's internal bind port.
# HOST_PORT=3000

# ── docker-compose.yml (bundled Postgres) only ───────────────────────────────
# Used to create that container's initial user/db — keep in sync with
# DATABASE_URL above. Not read by the app itself, and ignored by
# docker-compose.external-db.yml / docker-compose.build.yml's external-db use.
POSTGRES_USER=schduled
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schduled

# Everything else (SMTP, Google OAuth, Zoom, file storage, branding) is
# optional and can instead be set from the app itself — the setup wizard, or
# later from Settings → Services. See .env.example for the full list.
